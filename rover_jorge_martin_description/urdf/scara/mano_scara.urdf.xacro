<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="mano_scara" 
               params="prefix
                       muneca_mass:=2.0
                       dedo_mass:=0.5
                       ee_camera_topic:=/ee_camera/image
                       ee_camera_width:=640
                       ee_camera_height:=480
                       ee_camera_fov:=1.39626">
    
    <link name="${prefix}Muneca_visual">
      <collision name="${prefix}Muneca_collision">
        <origin rpy="0 0 0" xyz="0 0 0.11224"/>
        <geometry>
          <box size="1.00000 0.15000 0.20283"/>
        </geometry>
      </collision>
      <inertial>
        <inertia ixx="0.06071" ixy="0" ixz="0" iyy="0.21649" iyz="0" izz="0.16296"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <mass value="${muneca_mass}"/>
      </inertial>
      <visual name="${prefix}Muneca_visual_mesh">
        <material name="${prefix}Muneca_material"/>
        <origin rpy="0 0 0" xyz="0 0 0.08292"/>
        <geometry>
          <mesh filename="file:///home/longas/.gz/sim/models/rover_jorge_martin_description/meshes/dae/Circle.013.dae" scale="0.035 0.035 0.15027"/>
        </geometry>
      </visual>
    </link>

    <link name="${prefix}Dedo_drch_visual">
      <collision name="${prefix}Dedo_drch_collision">
        <origin rpy="0 0 0" xyz="0 0 0.13332"/>
        <geometry>
          <box size="0.15000 0.15000 0.50000"/>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100</mu>
              <mu2>100</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <inertia ixx="0.00985" ixy="0" ixz="-0.00099" iyy="0.00971" iyz="0" izz="0.00174"/>
        <origin rpy="0 0 0" xyz="-0.83436 0 0.05214"/>
        <mass value="${dedo_mass}"/>
      </inertial>
      <visual name="${prefix}Dedo_drch_visual_mesh">
        <material name="${prefix}Dedo_material"/>
        <origin rpy="0 0 0" xyz="0 0 0.13332"/>
        <geometry>
          <mesh filename="file:///home/longas/.gz/sim/models/rover_jorge_martin_description/meshes/dae/Cube.014.dae" scale="0.075 0.075 0.250"/>
        </geometry>
      </visual>
    </link>

    <link name="${prefix}Dedo_izq_visual">
      <collision name="${prefix}Dedo_izq_collision">
        <origin rpy="0 0 0" xyz="0 0 0.13332"/>
        <geometry>
          <box size="0.15000 0.15000 0.50000"/>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100</mu>
              <mu2>100</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <inertia ixx="0.00985" ixy="0" ixz="0.00099" iyy="0.00971" iyz="0" izz="0.00174"/>
        <origin rpy="0 0 0" xyz="-0.83436 0 0.05214"/>
        <mass value="${dedo_mass}"/>
      </inertial>
      <visual name="${prefix}Dedo_izq_visual_mesh">
        <material name="${prefix}Dedo_material"/>
        <origin rpy="0 0 0" xyz="0 0 0.13332"/>
        <geometry>
          <mesh filename="file:///home/longas/.gz/sim/models/rover_jorge_martin_description/meshes/dae/Cube.016.dae" scale="0.075 0.075 0.250"/>
        </geometry>
      </visual>
    </link>

    <link name="${prefix}Muneca_link"/>
    <link name="${prefix}Dedo_drch_link"/>
    <link name="${prefix}Dedo_izq_link"/>

    <link name="${prefix}ee_camera_frame">
      <visual name="${prefix}ee_camera_visual">
        <material name="${prefix}ee_camera_material"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <box size="0.06 0.04 0.04"/>
        </geometry>
      </visual>
    </link>

    <joint name="${prefix}Muneca_visual_joint" type="fixed">
      <parent link="${prefix}Muneca_link"/>
      <child link="${prefix}Muneca_visual"/>
      <origin rpy="0 0 1.5707" xyz="0 0 0"/>
    </joint>

    <joint name="${prefix}Dedo_drch_visual_joint" type="fixed">
      <parent link="${prefix}Dedo_drch_link"/>
      <child link="${prefix}Dedo_drch_visual"/>
      <origin rpy="0 0 1.5707" xyz="0 0 0"/>
    </joint>

    <joint name="${prefix}Dedo_izq_visual_joint" type="fixed">
      <parent link="${prefix}Dedo_izq_link"/>
      <child link="${prefix}Dedo_izq_visual"/>
      <origin rpy="0 0 -1.5707" xyz="0 0 0"/>
    </joint>

    <joint name="${prefix}ee_camera_joint" type="fixed">
      <parent link="${prefix}Muneca_link"/>
      <child link="${prefix}ee_camera_frame"/>
      <origin rpy="0 1.57 0" xyz="0 0 0"/>
    </joint>

    <joint name="${prefix}Muneca_link_joint" type="continuous">
      <limit effort="200.0" velocity="1"/>
      <origin rpy="0 0 0" xyz="0 0 -1.71134"/>
      <parent link="${prefix}Brazo4_link"/>
      <child link="${prefix}Muneca_link"/>
      <axis xyz="0 0 1"/>
    </joint>

    <joint name="${prefix}Dedo_drch_link_joint" type="prismatic">
      <limit lower="0" upper="0.30000" effort="500.0" velocity="1.0"/>
      <origin rpy="0 0 0" xyz="0 -0.42500 -0.37634"/>
      <parent link="${prefix}Muneca_link"/>
      <child link="${prefix}Dedo_drch_link"/>
      <axis xyz="0 1 0"/>
    </joint>

    <joint name="${prefix}Dedo_izq_link_joint" type="prismatic">
      <limit lower="-0.30000" upper="0" effort="500.0" velocity="1.0"/>
      <origin rpy="0 0 0" xyz="0 0.42500 -0.37634"/>
      <parent link="${prefix}Muneca_link"/>
      <child link="${prefix}Dedo_izq_link"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${prefix}ee_camera_frame">
      <sensor name="${prefix}ee_camera" type="camera">
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <topic>${ee_camera_topic}</topic>
        <camera>
          <horizontal_fov>${ee_camera_fov}</horizontal_fov>
          <image>
            <width>${ee_camera_width}</width>
            <height>${ee_camera_height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.10</near>
            <far>15.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <optical_frame_id>${prefix}ee_camera_frame</optical_frame_id>
        </camera>
      </sensor>
    </gazebo>
    
    <material name="${prefix}Muneca_material">
      <color rgba="0.28627 0.23922 0.25882 1.0"/>
    </material>
    <material name="${prefix}Dedo_material">
      <color rgba="0.79608 0.05882 0.08627 1.0"/>
    </material>
    <material name="${prefix}ee_camera_material">
      <color rgba="0.0 1.0 0.0 1.0"/>
    </material>

  </xacro:macro>

</robot>