<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="rueda" 
               params="name
                       parent_link
                       xyz
                       rpy
                       wheel_radius:=0.375
                       wheel_length:=0.300
                       wheel_mass:=5.0">
    
    <link name="${name}_visual">
      <collision name="${name}_collision_visual">
        <origin rpy="0 0 0" xyz="0.00003 0.00018 -0.00054"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_length}"/></geometry>
      </collision>
      <inertial>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <mass value="${wheel_mass}"/>
      </inertial>
      <visual name="${name}_visual_mesh">
        <material name="${name}_material"/>
        <origin rpy="0 -1.5708 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file:///home/longas/.gz/sim/models/rover_jorge_martin_description/meshes/dae/Circle.008.dae" scale="1 1 1"/>
        </geometry>
      </visual>
    </link>

    <link name="${name}_link">
      <collision name="${name}_collision">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.5</mu2>
              <fdir1>0 0 1</fdir1>
              <slip1>0.5</slip1>
              <slip2>0.5</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <mass value="${wheel_mass}"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="continuous">
      <limit effort="500" velocity="20"/>
      <origin rpy="${rpy}" xyz="${xyz}"/>
      <parent link="${parent_link}"/>
      <child link="${name}_link"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.5"/>
    </joint>

    <joint name="${name}_visual_joint" type="fixed">
      <parent link="${name}_link"/>
      <child link="${name}_visual"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </joint>

    <transmission name="${name}_transmission">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${name}_joint">
        <hardwareInterface>hardwareInterface/VelocityJointInterface</hardwareInterface>
      </joint>
      <actuator name="${name}_actuator">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <gazebo reference="${name}_joint">
      <mu1>5</mu1>
      <mu2>5</mu2>
    </gazebo>

    <material name="${name}_material">
      <color rgba="0.0902 0.0902 0.0902 1.0"/>
    </material>

  </xacro:macro>

</robot>